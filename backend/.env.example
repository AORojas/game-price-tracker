PORT=3000
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
CHEAPSHARK_API_URL=https://www.cheapshark.com/api/1.0
# Choose local for offline demos, or igdb/rawg/steam for live metadata.
GAME_METADATA_PROVIDER=igdb
# Create a confidential application in the Twitch Developer Portal.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
# SteamGridDB supplies cover artwork; Steam Store supplies descriptions, genres, and screenshots.
STEAMGRIDDB_API_KEY=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=game_price_tracker
DB_USER=postgres
DB_PASSWORD=

# Google Identity Services uses an ID token, verified against this client ID.
GOOGLE_CLIENT_ID=
# ID-token verification does not use GOOGLE_CLIENT_SECRET; never expose it as VITE_*.
# Steam OpenID profile lookup. The key is only used on the backend.
STEAM_API_KEY=

# Notificaciones por Email (Resend)
RESEND_API_KEY=re_123456789_abcde
RESEND_FROM_EMAIL=onboarding@resend.dev

# Frecuencia del Cron Job (en horas)
CRON_INTERVAL_HOURS=1
